{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "ninja",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": { "BUILD_TESTING": "ON" }
    },
    {
      "name": "windows-x64",
      "hidden": true,
      "inherits": "ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" }
    },
    {
      "name": "windows-gui",
      "hidden": true,
      "inherits": "windows-x64",
      "toolchainFile": "${sourceDir}/cmake/BrassCueWindowsVcpkgToolchain.cmake",
      "cacheVariables": {
        "BRASSCUE_BUILD_GUI": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_MODE": "OFF",
        "VCPKG_APPLOCAL_DEPS": "ON"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "inherits": "windows-gui",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release",
      "inherits": "windows-gui",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-x64-web-debug",
      "displayName": "Windows x64 Debug with WebView",
      "inherits": "windows-x64-debug",
      "cacheVariables": { "BRASSCUE_ENABLE_WEB_PANEL": "ON" }
    },
    {
      "name": "windows-x64-web-release",
      "displayName": "Windows x64 Release with WebView",
      "inherits": "windows-x64-release",
      "cacheVariables": { "BRASSCUE_ENABLE_WEB_PANEL": "ON" }
    },
    {
      "name": "windows-x64-headless",
      "displayName": "Windows x64 Debug (headless)",
      "inherits": "windows-x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BRASSCUE_BUILD_GUI": "OFF" }
    },
    {
      "name": "linux-headless",
      "hidden": true,
      "inherits": "ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "BRASSCUE_BUILD_GUI": "OFF" }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (headless)",
      "inherits": "linux-headless",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release (headless)",
      "inherits": "linux-headless",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug" },
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release" },
    { "name": "windows-x64-web-debug", "configurePreset": "windows-x64-web-debug" },
    { "name": "windows-x64-web-release", "configurePreset": "windows-x64-web-release" },
    { "name": "windows-x64-headless", "configurePreset": "windows-x64-headless" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" }
  ],
  "testPresets": [
    {
      "name": "report-tests",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug", "inherits": "report-tests" },
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release", "inherits": "report-tests" },
    { "name": "windows-x64-web-debug", "configurePreset": "windows-x64-web-debug", "inherits": "report-tests" },
    { "name": "windows-x64-web-release", "configurePreset": "windows-x64-web-release", "inherits": "report-tests" },
    { "name": "windows-x64-headless", "configurePreset": "windows-x64-headless", "inherits": "report-tests" },
    { "name": "linux-debug", "configurePreset": "linux-debug", "inherits": "report-tests" },
    { "name": "linux-release", "configurePreset": "linux-release", "inherits": "report-tests" }
  ]
}
